GHOST_URL=http://localhost:2368
GHOST_KEY=
# Defaults to the origin of GHOST_URL. Set this when Ghost's API and theme use different hosts.
CORS_ORIGIN=
# Generate with pnpm password; clients send the SHA-256 hex digest of their password.
ADMIN_PASSWORD=
COMMENTS_MAX_COUNT=10000
COMMENTS_MAX_AUTHOR=32
COMMENTS_MAX_CONTENT=1500
BACKEND_SQLITE_PATH=./data
PORT=11005
