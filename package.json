{
  "name": "kaede-api",
  "version": "2.1.0",
  "private": true,
  "description": "An api server for kaede, a neat ghost theme",
  "license": "MIT",
  "author": "Khinenw",
  "repository": "https://github.com/HelloWorld017/kaede-api",
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "mkdir -p data && pnpm build && concurrently --kill-others 'pnpm dev:bundle' 'pnpm dev:server'",
    "dev:bundle": "rolldown -c --watch",
    "dev:server": "dotenv -- workerd serve --watch backend.capnp config --import-path ./dist --directory-path do-storage=./data --socket-addr http=127.0.0.1:11005",
    "start": "kaede-api",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "password": "nix run .#genpassword"
  },
  "dependencies": {
    "@tryghost/content-api": "1.12.13",
    "axios": "1.20.0",
    "hono": "4.13.14",
    "kysely": "0.29.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/node": "^26.6.6",
    "@types/tryghost__content-api": "1.3.17",
    "concurrently": "10.0.6",
    "dotenv-cli": "11.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "rolldown": "1.2.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.9.0"
}
